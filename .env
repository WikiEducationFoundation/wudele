# This file defines a list of environment variables used to configure the application.
#
# PLEASE DON'T CHANGE THE VALUES OF THIS FILE! They are used as default values.
# Any change in this file would be deleted at the next update.
#
# To configure the application in production, copy the file env.sample as .env.local instead.

####################################
# Configuration of the application #
####################################
APP_ENV="dev"
APP_SECRET=""
APP_BASE_URL=""
APP_NAME="Pollaris"
APP_REQUIRE_EMAILS=false
APP_TIMEZONE=""
APP_SHARE_DIR=var/share

#################################
# Poll expiration configuration #
#################################
POLL_EXPIRES_COMPLETED=""
POLL_EXPIRES_INCOMPLETE=""

#################################
# Configuration of the database #
#################################
DATABASE_URL=""

####################################
# Configuration of the mail system #
####################################
MAILER_DSN="null://null"

########################################
# Configuration of the SMTP mailserver #
########################################
MAILER_DSN="null://null"
MAILER_FROM="noreply@example.com"
MAILER_FROM_NAME="Pollaris admin"

#####################################
# Configuration of the async system #
#####################################
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0&check_delayed_interval=30000"
