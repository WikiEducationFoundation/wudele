{% set countYes = proposal.countAnswers('yes') %}
{% set countMaybe = proposal.countAnswers('maybe') %}
{% set countNo = proposal.countAnswers('no') %}

<fieldset class="panel panel--white panel--rounded flow">
    <div class="cols cols--always">
        <legend class="col--extend text--nobold">{{ proposal.label }}</legend>

        {% if isPreferred %}
            <p class="text--success">
                {{ icon('star') }}

                {{ 'polls.votes.yes.count' | trans({ count: countYes }) }}

                <span class="sr-only">
                    {{ 'polls.proposals.best' | trans }}
                </span>
            </p>
        {% elseif countYes > 0 %}
            <p>
                {{ 'polls.votes.yes.count' | trans({ count: countYes }) }}
            </p>
        {% endif %}
    </div>

    {% if voteForm %}
        {% set answerForm = voteForm | getAnswerFormForProposal(proposal) %}
        {{ form_row(answerForm) }}
    {% endif %}

    {% if maxCount > 0 %}
        <div class="panel__separator"></div>

        <ul class="list--nostyle flow flow--smaller">
            <li class="votebar votebar--yes cols cols--gap-small">
                <span class="col--size2 col--noshrink votebar__label">
                    {{ 'polls.votes.yes' | trans }}
                </span>

                <span class="col--extend">
                    {% if countYes > 0 %}
                        <span class="votebar__bar" style="--votebar-width: {{ countYes * 100 / maxCount }}%">
                            {{ countYes }}
                        </span>
                    {% else %}
                        –
                        <span class="sr-only">
                            {{ 'polls.votes.none' | trans }}
                        </span>
                    {% endif %}
                </span>
            </li>

            <li class="votebar votebar--maybe cols cols--gap-small">
                <span class="col--size2 col--noshrink votebar__label">
                    {{ 'polls.votes.maybe' | trans }}
                </span>

                <span class="col--extend">
                    {% if countMaybe > 0 %}
                        <span class="votebar__bar" style="--votebar-width: {{ countMaybe * 100 / maxCount }}%">
                            {{ countMaybe }}
                        </span>
                    {% else %}
                        –
                        <span class="sr-only">
                            {{ 'polls.votes.none' | trans }}
                        </span>
                    {% endif %}
                </span>
            </li>

            <li class="votebar votebar--no cols cols--gap-small">
                <span class="col--size2 col--noshrink votebar__label">
                    {{ 'polls.votes.no' | trans }}
                </span>

                <span class="col--extend">
                    {% if countNo > 0 %}
                        <span class="votebar__bar" style="--votebar-width: {{ countNo * 100 / maxCount }}%">
                            {{ countNo }}
                        </span>
                    {% else %}
                        –
                        <span class="sr-only">
                            {{ 'polls.votes.none' | trans }}
                        </span>
                    {% endif %}
                </span>
            </li>
        </ul>

        <div class="flow flow--smaller">
            {% for answers in proposal.answers | groupAnswersByValues %}
                {% if answers | length > 0 %}
                    <ul class="list--nostyle">
                        {% for answer in answers %}
                            {% if answer.value == 'yes' %}
                                <li class="vote vote--yes">
                                    {{ icon('square-check') }}

                                    {{ answer.vote.authorName }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.yes' | trans }}
                                    </span>
                                </li>
                            {% elseif answer.value == 'no' %}
                                <li class="vote vote--no">
                                    {{ icon('square-xmark') }}

                                    {{ answer.vote.authorName }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.no' | trans }}
                                    </span>
                                </li>
                            {% elseif answer.value == 'maybe' %}
                                <li class="vote vote--maybe">
                                    {{ icon('square-minus') }}

                                    {{ answer.vote.authorName }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.maybe' | trans }}
                                    </span>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</fieldset>
