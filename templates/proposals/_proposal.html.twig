{% set countYes = proposal.countAnswers('yes') %}
{% set countMaybe = proposal.countAnswers('maybe') %}
{% set countNo = proposal.countAnswers('no') %}

<fieldset class="panel panel--white panel--rounded panel--proposal flow">
    <div>
        <legend class="text--nobold">{{ proposal.label }}</legend>
    </div>

    {% if voteForm %}
        {% set answerForm = voteForm | getAnswerFormForProposal(proposal) %}
        {{ form_row(answerForm) }}
    {% endif %}

    {% if maxCount > 0 %}
        {% set answersByValues = proposal.answers | groupAnswersByValues %}

        <div class="panel__separator"></div>

        <ul class="list--nostyle flow flow--smaller">
            <li class="cols cols--gap-small votes">
                {% if isPreferred %}
                    <span class="col--size3 col--noshrink votes__label text--success">
                        {{ 'polls.votes.yes.count' | trans({ count: countYes }) }}

                        {{ icon('star') }}

                        <span class="sr-only">
                            {{ 'polls.proposals.best' | trans }}
                        </span>
                    </span>
                {% else %}
                    <span class="col--size3 col--noshrink votes__label">
                        {{ 'polls.votes.yes.count' | trans({ count: countYes }) }}
                    </span>
                {% endif %}

                {% if answersByValues['yes'] | length > 0 %}
                    <ul class="col--extended list--nostyle">
                        {% for answer in answersByValues['yes'] %}
                            <li class="vote vote--yes">
                                {{ icon('square-check') }}
                                {{ answer.vote.authorName }}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <span class="col--extend">
                        –
                    </span>
                {% endif %}
            </li>

            <li class="cols cols--gap-small votes">
                <span class="col--size3 col--noshrink votes__label">
                    {{ 'polls.votes.maybe.count' | trans({ count: countMaybe }) }}
                </span>

                {% if answersByValues['maybe'] | length > 0 %}
                    <ul class="col--extended list--nostyle">
                        {% for answer in answersByValues['maybe'] %}
                            <li class="vote vote--maybe">
                                {{ icon('square-xmark') }}
                                {{ answer.vote.authorName }}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <span class="col--extend">
                        –
                    </span>
                {% endif %}
            </li>

            <li class="cols cols--gap-small votes">
                <span class="col--size3 col--noshrink votes__label">
                    {{ 'polls.votes.no.count' | trans({ count: countNo }) }}
                </span>

                {% if answersByValues['no'] | length > 0 %}
                    <ul class="col--extended list--nostyle">
                        {% for answer in answersByValues['no'] %}
                            <li class="vote vote--no">
                                {{ icon('square-minus') }}
                                {{ answer.vote.authorName }}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <span class="col--extend">
                        –
                    </span>
                {% endif %}
            </li>
        </ul>
    {% endif %}
</fieldset>
