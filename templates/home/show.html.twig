{% extends 'base.html.twig' %}

{% block robots_head_tags %}{% endblock %}

{% block body %}
    <div class="wrapper flow flow--larger">
        {% for message in app.flashes('success') %}
            {% if message == 'poll.deleted' %}
                {{ include('notifications/_success.html.twig', { message: 'home.show.poll.deleted' | trans }) }}
            {% endif %}
        {% endfor %}

        <div class="flow text--center">
            <h1>
                {% if asset_exists('logo.png') %}
                    <img class="home__logo" src="{{ asset('logo.png') }}" alt="{{ appName }}">
                {% else %}
                    {{ appName }}
                {% endif %}
            </h1>

            <p class="text--primary text--big">
                {{ 'home.tagline' | trans }}
            </p>
        </div>

        <div class="cols cols--gap-large">
            <div class="col--extend flow text--center">
                <p>
                    <a class="button button--primary" href="{{ path('new poll', { type: 'date', flow: 'on' }) }}">
                        {{ 'home.schedule_event' | trans }}
                    </a>
                </p>

                <img class="home__example" src="{{ asset('example-date.png') }}" alt="{{ 'home.schedule_event.example' | trans }}">
            </div>

            <div class="col--extend flow text--center">
                <p>
                    <a class="button button--primary" href="{{ path('new poll', { type: 'classic', flow: 'on' }) }}">
                        {{ 'home.standard_poll' | trans }}
                    </a>
                </p>

                <img class="home__example" src="{{ asset('example-classic.png') }}" alt="{{ 'home.standard_poll.example' | trans }}">
            </div>
        </div>

        <p class="text--center">
            <a href="{{ path('my') }}">
                {{ 'home.find_polls' | trans }}
            </a>
        </p>

        <p class="text--secondary">
            {% if appName == 'Pollaris' %}
                {{ 'home.free_software' | trans }}
            {% else %}
                {{ 'home.free_software.custom' | trans({ appName: appName }) }}
            {% endif %}

            <a href="https://github.com/WikiEducationFoundation/wudele">
                {{ 'home.source_code' | trans }}
            </a>
        </p>
    </div>
{% endblock %}
