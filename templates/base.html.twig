<!DOCTYPE html>
<html lang="{{ app.locale|locale_to_bcp47 }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {% set block_title = block('title') %}
        {% if block_title is not empty %}
            <title>{% block title %}{% endblock %} – Pollaris</title>
        {% else %}
            <title>{{ 'base.default_title' | trans }}</title>
        {% endif %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ esbuild_asset('styles/application.css') }}" data-turbo-track="reload">
        {% endblock %}

        {% block javascripts %}
            <script src="{{ esbuild_asset('js/application.js') }}" defer data-turbo-track="reload"></script>
        {% endblock %}
    </head>

    <body>
        <div class="layout" id="layout">
            {% block header %}
                <header class="layout__header header" role="banner">
                    <a class="header__title" href="{{ path('home') }}">
                        Pollaris
                    </a>
                </header>
            {% endblock %}

            <main class="layout__body" id="content" tabindex="-1">
                {% block body %}
                {% endblock %}
            </main>
        </div>

        {{ include('_modal_dialog.html.twig') }}
    </body>
</html>
