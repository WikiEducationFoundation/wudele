{% extends 'base.html.twig' %}

{% block title %}{{ poll.title }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="text--center flow">
            <h1>
                {{ poll.title }}
            </h1>

            <p class="text--secondary">
                {{ 'polls.show.created' | trans({ by: poll.authorName, at: poll.createdAt | dateShort }) }}
            </p>
        </div>

        {% if poll.description %}
            <p class="panel panel--rounded">
                {{ poll.description }}
            </p>
        {% endif %}

        {% block poll_body %}
        {% endblock %}
    </div>
{% endblock %}
