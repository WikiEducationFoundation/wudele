{% extends 'base.html.twig' %}

{% block title %}{{ 'polls.proposals.title' | trans }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <h1>
            {{ 'polls.proposals.title' | trans }}
        </h1>

        {{ form_start(form) }}
            <div
                class="flow"
                data-controller="form-proposals"
                data-form-proposals-index-value="{{ form.proposals|length > 0 ? form.proposals|last.vars.name + 1 : 0 }}"
            >
                <div data-form-proposals-target="proposalsContainer" class="flow">
                    {% for proposal in form.proposals %}
                        <div class="panel panel--rounded panel--primary flow" data-item="proposal">
                            {{ form_row(proposal.label) }}

                            {% if not loop.first %}
                                <button
                                    type="button"
                                    class="button--ghost button--block"
                                    data-action="form-proposals#removeProposal"
                                >
                                    {{ 'forms.poll_proposals_form.remove_proposal' | trans }}
                                </button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <template data-form-proposals-target="proposalPrototype">
                    <div class="panel panel--rounded panel--primary flow" data-item="proposal">
                        {{ form_row(form.proposals.vars.prototype) }}

                        <button
                            type="button"
                            class="button--ghost button--block"
                            data-action="form-proposals#removeProposal"
                        >
                            {{ 'forms.poll_proposals_form.remove_proposal' | trans }}
                        </button>
                    </div>
                </template>

                <button
                    type="button"
                    data-action="form-proposals#addProposal"
                >
                    {{ 'forms.poll_proposals_form.add_proposal' | trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
