{% extends 'base.html.twig' %}

{% block title %}{{ 'polls.new.title' | trans }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="flow">
            <h1>
                {{ 'polls.new.title' | trans }}
            </h1>

            <p class="text--secondary">
                {{ 'polls.steps' | trans({ step: currentStep, total: poll.totalSteps }) }}
            </p>
        </div>

        {{ form(form) }}
    </div>
{% endblock %}
