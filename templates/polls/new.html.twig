{% extends 'base.html.twig' %}

{% block title %}{{ 'polls.new.title' | trans }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="flow">
            <h1>
                {{ 'polls.new.title' | trans }}
            </h1>

            <p class="text--secondary">
                {{ 'polls.steps' | trans({ step: flow.stepNumber('init'), total: flow.totalSteps }) }}
            </p>
        </div>

        {{ form_start(form) }}
            {{ form_errors(form) }}

            <div class="panel panel--primary panel--rounded flow flow--large">
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
                {{ form_row(form.closedAt) }}
            </div>

            <fieldset class="panel panel--primary panel--rounded">
                <legend>{{ 'polls.new.who_you_are' | trans }}</legend>

                <div class="flow flow--large">
                    {{ form_row(form.authorName) }}
                    {{ form_row(form.authorEmail) }}
                </div>
            </fieldset>

            <div class="text--right">
                {{ form_row(form.submit) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
