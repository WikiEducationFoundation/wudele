{% extends 'base.html.twig' %}

{% block title %}{{ poll.title }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="panel panel--primary panel--rounded flow flow--large">
            <div class="flow flow--small">
                <h1>
                    {{ poll.title }}
                </h1>

                {% if poll.description %}
                    <p>
                        {{ poll.description }}
                    </p>
                {% endif %}

                <p class="text--secondary">
                    {{ 'polls.show.created_by' | trans({ by: poll.authorName }) }}
                </p>
            </div>

            <p>
                <a class="button button--primary" href="{{ path('new vote', { pollId: poll.id }) }}">
                    {{ 'polls.show.vote' | trans }}
                </a>
            </p>
        </div>

        {% set preferredChoices = poll.preferredChoices %}
        {% if preferredChoices %}
            {% set firstChoice = preferredChoices|first %}

            <div class="flow">
                <h2 class="text--primary">
                    {{ 'polls.show.best_proposals.title' | trans(count: preferredChoices|length) }}
                </h2>

                <div class="panel panel--primary panel--rounded flow">
                    <p>
                        {{ 'polls.show.best_proposals.info' | trans({
                            countChoices: preferredChoices|length,
                            countYes: firstChoice.countAnswers('yes'),
                        }) }}
                    </p>

                    <div class="panel panel--success panel--rounded panel--border">
                        {% if preferredChoices|length == 1 %}
                            <p class="flow flow--small">
                                {% set date = firstChoice.date %}
                                {% if date %}
                                    <span class="text--block text--bold">{{ date.value | dateTrans('EEEE d MMMM yyyy') }}</span>
                                    <span class="text--block">{{ firstChoice.label }}</span>
                                {% else %}
                                    <span class="text--bold">{{ firstChoice.label }}</span>
                                {% endif %}
                            </p>
                        {% elseif poll.isClassicPoll %}
                            <ul class="list--nostyle flow flow--small">
                                {% for choice in preferredChoices %}
                                    <li class="text--bold">
                                        {{ choice.label }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% elseif poll.isDatePoll %}
                            <ul class="list--nostyle flow flow--small">
                                {% for dateAndChoices in preferredChoices|groupDateProposals %}
                                    {% set date = dateAndChoices[0] %}
                                    {% set choices = dateAndChoices[1] %}

                                    <li class="flow flow--small">
                                        <span class="text--block text--bold">{{ date.value | dateTrans('EEEE d MMMM yyyy') }}</span>

                                        {% if choices|length == 1 %}
                                            <span class="text--block">{{ choices[0].label }}</span>
                                        {% else %}
                                            <ul class="list--nostyle flow flow--small">
                                                {% for choice in choices %}
                                                    <li>{{ choice.label }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        <div
            class="flow"
            data-controller="view"
            data-view-first-value="simple"
            data-view-second-value="details"
        >
            {% set maxCount = poll.maxCount %}

            <div class="cols cols--always cols--center cols--gap-small">
                <h2 class="col--extend text--primary">{{ 'polls.show.poll' | trans }}</h2>

                {% if maxCount > 0 %}
                    <button class="button--ghost" data-action="view#switch">
                        <span data-view-target="view" data-view-value="simple">
                            {{ icon('magnifying-glass-chart') }}
                            {{ 'polls.show.view_details' | trans }}
                        </span>

                        <span data-view-target="view" data-view-value="details" hidden>
                            {{ icon('chart-simple') }}
                            {{ 'polls.show.view_simple' | trans }}
                        </span>
                    </button>
                {% endif %}
            </div>

            {% if maxCount == 0 %}
                <p class="panel panel--primary panel--rounded panel--border text--primary">
                    {{ 'polls.show.no_vote' | trans }}
                </p>
            {% endif %}

            {% if poll.isClassicPoll %}
                {% for proposal in poll.proposals %}
                    <div class="panel panel--primary panel--rounded">
                        {{ include('proposals/_proposal.html.twig', {
                            proposal: proposal,
                            isPreferred: preferredChoices and proposal in preferredChoices,
                            maxCount: maxCount,
                        }) }}
                    </div>
                {% endfor %}
            {% elseif poll.isDatePoll %}
                {% for dateAndProposals in poll.proposals|groupDateProposals %}
                    {% set date = dateAndProposals[0] %}
                    {% set proposals = dateAndProposals[1] %}

                    <div class="panel panel--primary panel--rounded flow">
                        <h3>{{ date.value | dateTrans('EEEE d MMMM yyyy') }}</h3>

                        {% for proposal in proposals %}
                            {{ include('proposals/_proposal.html.twig', {
                                proposal: proposal,
                                isPreferred: preferredChoices and proposal in preferredChoices,
                                maxCount: maxCount,
                            }) }}
                        {% endfor %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
