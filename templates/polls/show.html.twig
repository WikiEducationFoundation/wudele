{% extends 'base.html.twig' %}

{% block title %}{{ poll.title }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <h1>
            {{ poll.title }}
        </h1>

        {% if poll.description %}
            <p>
                {{ poll.description }}
            </p>
        {% endif %}

        <ul>
            {% for proposal in poll.proposals %}
                <li>
                    {{ proposal.label }}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
