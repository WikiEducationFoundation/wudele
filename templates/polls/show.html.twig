{% extends 'poll.html.twig' %}

{% block poll_body %}
    <p class="text--center">
        <a class="button button--primary" href="{{ path('new vote', { pollId: poll.id }) }}">
            {{ 'polls.show.go_to_vote' | trans }}
        </a>
    </p>

    {% set preferredChoices = poll.preferredChoices %}
    {% if preferredChoices %}
        {% set firstChoice = preferredChoices|first %}

        <div class="flow">
            <h2>
                {{ 'polls.show.best_proposals.title' | trans(count: preferredChoices|length) }}
                <span aria-hidden="true">⭐</span>
            </h2>

            <div class="panel panel--primary panel--rounded flow">
                <p>
                    {{ 'polls.show.best_proposals.info' | trans({
                        countChoices: preferredChoices|length,
                        countYes: firstChoice.countAnswers('yes'),
                    }) }}

                    {% if preferredChoices|length == 1 %}
                        <strong>{{ firstChoice | proposalFullLabel }}</strong>
                    {% endif %}
                </p>

                {% if preferredChoices|length > 1 %}
                    <ul class="flow flow--small">
                        {% for choice in preferredChoices %}
                            <li>
                                <strong>{{ choice | proposalFullLabel }}</strong>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <div class="flow">
        <h2>{{ 'polls.show.results' | trans }}</h2>

        <div class="panel panel--primary panel--rounded">
            {% for proposal in poll.proposals %}
                <details class="accordion">
                    <summary class="accordion__title flow">
                        <p class="text--bold">{{ proposal | proposalFullLabel }}</p>

                        <ul class="list--nostyle cols cols--gap cols--always">
                            <li>
                                {{ 'polls.show.results.yes' | trans({ count: proposal.countAnswers('yes') }) }}
                            </li>

                            <li>
                                {{ 'polls.show.results.maybe' | trans({ count: proposal.countAnswers('maybe') }) }}
                            </li>

                            <li>
                                {{ 'polls.show.results.no' | trans({ count: proposal.countAnswers('no') }) }}
                            </li>
                        </ul>
                    </summary>

                    <div class="accordion__body">
                        {% if proposal.answers | length > 0 %}
                            <ul>
                                {% for answer in proposal.answers %}
                                    <li>
                                        {{ 'polls.show.results.answer' | trans({ name: answer.vote.authorName, answer: answer.humanValue }) }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="panel panel--rounded">
                                {{ 'polls.show.results.answer.none' | trans }}
                            </p>
                        {% endif %}
                    </div>
                </details>
            {% endfor %}
        </div>
    </div>
{% endblock %}
