{% extends 'base.html.twig' %}

{% block title %}{{ 'polls.summary.title' | trans }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="flow">
            <h1>
                {{ 'polls.summary.title' | trans }}
            </h1>

            <p class="text--secondary">
                {{ 'polls.steps' | trans({ step: process.stepNumber('summary'), total: process.totalSteps }) }}
            </p>
        </div>

        {{ form_start(form, { attr: { class: 'flow flow--larger' } }) }}
            {{ form_errors(form) }}

            {{ include('polls/_summary.html.twig') }}

            <div class="cols cols--always cols--gap">
                <a class="button" href="{{ process.previousStepUrl('summary') }}">
                    {{ 'forms.previous' | trans }}
                </a>

                <div class="col--extend"></div>

                {{ form_row(form.submit) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
