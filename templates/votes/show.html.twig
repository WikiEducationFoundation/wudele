{% extends 'poll.html.twig' %}

{% block poll_body %}
    <div class="panel panel--success panel--rounded flow">
        <p class="text--big text--center">
            <strong>
                {{ 'votes.show.success' | trans({ name: vote.authorName }) }}
            </strong>
        </p>

        <p>
            {{ 'votes.show.summary_answers' | trans }}
        </p>

        <ul>
            {% for answer in vote.answers %}
                <li>
                    {{ 'votes.show.answer' | trans({ proposal: answer.proposal.label, answer: answer.humanValue }) }}
                </li>
            {% endfor %}
        </ul>
    </div>

    <p class="text--center">
        <a class="button button--primary" href="{{ path('poll', { id: poll.id }) }}">
            {{ 'votes.show.back_to_poll' | trans }}
        </a>
    </p>
{% endblock %}
