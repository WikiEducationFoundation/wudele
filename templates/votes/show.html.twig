{% extends 'poll.html.twig' %}

{% block poll_body %}
    <div class="panel panel--success panel--rounded flow">
        <p class="text--big text--center">
            <strong>
                {{ 'votes.show.success' | trans({ name: vote.authorName }) }}
            </strong>
        </p>

        <p>
            {{ 'votes.show.summary_answers' | trans }}
        </p>

        <ul>
            {% for answer in vote.answers %}
                <li>
                    {{ 'votes.show.answer' | trans({
                        proposal: answer.proposal | proposalFullLabel,
                        answer: answer.humanValue,
                    }) }}
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="cols cols--gap cols--center cols--always">
        <div class="col--extend">
            <a class="button" href="{{ path('edit vote', { pollId: poll.id, id: vote.id }) }}">
                {{ 'votes.show.edit' | trans }}
            </a>
        </div>

        <a class="button button--primary" href="{{ path('poll', { id: poll.id }) }}">
            {{ 'votes.show.back_to_poll' | trans }}
        </a>
    </div>
{% endblock %}
