{{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.authorName) }}

    {% for answer in form.answers %}
        <fieldset class="panel panel--primary panel--rounded flow">
            <legend>{{ field_label(answer.value) }}</legend>

            <div class="cols cols--gap cols--always">
                {% for choice in answer.value.vars.choices %}
                    <div class="col--extend">
                        <input
                            id="{{ field_id(answer.value, choice.value) }}"
                            type="radio"
                            name="{{ field_name(answer.value) }}"
                            value="{{ choice.value }}"
                            {{ choice.value == field_value(answer.value) ? 'checked' }}
                        />

                        <label for="{{ field_id(answer.value, choice.value) }}">
                            {{ choice.label | trans }}
                        </label>
                    </div>
                {% endfor %}
            </div>
        </fieldset>
    {% endfor %}

    <div class="cols cols--gap cols--center cols--always">
        <div class="col--extend">
            <a class="button" href="{{ urlCancel }}">
                {{ 'votes.new.cancel' | trans }}
            </a>
        </div>

        <div class="col--extend">
            {{ form_row(form.submit) }}
        </div>
    </div>
{{ form_end(form) }}
