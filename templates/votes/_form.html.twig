{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="panel panel--primary panel--rounded">
        {{ form_row(form.authorName) }}
    </div>

    {% if poll.isClassicPoll %}
        {% for answer in form.answers %}
            <div class="panel panel--primary panel--rounded">
                {{ form_row(answer) }}
            </div>
        {% endfor %}
    {% elseif poll.isDatePoll %}
        {% for date, answers in form.answers | groupAnswerFormsByDate %}
            <fieldset class="panel panel--primary panel--rounded">
                <legend>{{ date }}</legend>

                {% for answer in answers %}
                    {{ form_row(answer) }}
                {% endfor %}
            </fieldset>
        {% endfor %}
    {% endif %}

    <div class="cols cols--always cols--gap">
        <a class="button" href="{{ urlCancel }}" data-turbo-method="get" data-turbo-confirm="{{ cancelConfirm }}">
            {{ 'forms.cancel' | trans }}
        </a>

        <div class="col--extend"></div>

        {{ form_row(form.submit) }}
    </div>
{{ form_end(form) }}
